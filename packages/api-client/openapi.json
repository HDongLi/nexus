  "paths": {
    "/api/v1/system/health": {
      "get": {
        "operationId": "getSystemHealth",
        "summary": "健康探测",
        "description": "给反向代理和守护进程用。进程活着但数据库连不上时回 503，响应体的形状不变。",
        "tags": [
          "system"
        ],
        "responses": {
          "200": {
            "description": "一切正常",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok",
                        "degraded"
                      ]
                    },
                    "version": {
                      "type": "string",
                      "minLength": 1
                    },
                    "time": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "checks": {
                      "type": "object",
                      "properties": {
                        "db": {
                          "type": "string",
                          "enum": [
                            "ok",
                            "fail"
                          ]
                        }
                      },
                      "required": [
                        "db"
                      ]
                    }
                  },
                  "required": [
                    "status",
                    "version",
                    "time",
                    "checks"
                  ]
                }
              }
            }
          },
          "500": {
            "description": "服务器内部错误",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string",
                          "minLength": 1
                        },
                        "message": {
                          "type": "string",
                          "minLength": 1
                        },
                        "requestId": {
                          "type": "string",
                          "minLength": 1
                        },
                        "details": {
                          "type": "object",
                          "additionalProperties": {}
                        }
                      },
                      "required": [
                        "code",
                        "message",
                        "requestId"
                      ]
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "503": {
            "description": "进程活着，但有检查项不过",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok",
                        "degraded"
                      ]
                    },
                    "version": {
                      "type": "string",
                      "minLength": 1
                    },
                    "time": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "checks": {
                      "type": "object",
                      "properties": {
                        "db": {
                          "type": "string",
                          "enum": [
                            "ok",
                            "fail"
                          ]
                        }
                      },
                      "required": [
                        "db"
                      ]
                    }
                  },
                  "required": [
                    "status",
                    "version",
                    "time",
                    "checks"
                  ]
                }
              }
            }
          }
        },
        "x-auth": "public"
      }
    },
    "/api/v1/system/info": {
