        "responses": {
          "200": {
            "description": "已退出。响应头里有一条清除 cookie 的 Set-Cookie",
            "headers": {
              "Set-Cookie": {
                "description": "清除会话 cookie nexus_session：Max-Age=0，Expires 是过去的时间",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
