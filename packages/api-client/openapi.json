                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string",
                          "minLength": 1
                        },
                        "message": {
                          "type": "string",
                          "minLength": 1
                        },
                        "requestId": {
                          "type": "string",
                          "minLength": 1
                        },
                        "details": {
                          "type": "object",
                          "properties": {
                            "retryAfterSeconds": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 900
                            }
                          },
                          "required": [
                            "retryAfterSeconds"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "required": [
                        "code",
